# Chép thành .env rồi sửa. Mọi biến đều tuỳ chọn.

# Phiên bản image và cổng mở ra máy chủ
HORUS_VERSION=latest
HORUS_PORT=8199

# Mật khẩu hai tài khoản — CHỈ có hiệu lực lần chạy đầu (khi chưa có data/users.json).
# Đổi trước khi cài.
CBQH_PASSWORD=cbqh@2026
QTHT_PASSWORD=qtht@2026

APP_TZ=Asia/Ho_Chi_Minh

# Model. Đổi FACE_MODEL thì phải đăng ký lại toàn bộ khuôn mặt.
YOLO_MODEL=yolo11s.pt
FACE_MODEL=buffalo_l
FACE_SIM_THRESHOLD=0.36
FACE_DET_SIZE=960
FACE_DET_THRESHOLD=0.30

# Luồng xem trực tiếp
STREAM_MAX_WIDTH=960
STREAM_JPEG_QUALITY=65
STREAM_OPEN_TIMEOUT=8
STREAM_RTSP_TRANSPORT=tcp
