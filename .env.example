# Chép thành .env rồi sửa. Mọi biến đều tuỳ chọn.

# Phiên bản image và cổng mở ra máy chủ
HORUS_VERSION=latest
HORUS_PORT=8199

# Mật khẩu hai tài khoản — CHỈ có hiệu lực lần chạy đầu (khi chưa có data/users.json).
# Đổi trước khi cài.
CBQH_PASSWORD=cbqh@2026
QTHT_PASSWORD=qtht@2026

APP_TZ=Asia/Ho_Chi_Minh

# Phần cứng AI (xem app/hw.py). Để trống/"auto" thì tự dò máy lúc khởi động và áp
# giá trị mặc định theo CPU hoặc GPU; chỉ set khi cần ghi đè. Set rồi thì áp dụng
# cho MỌI biến YOLO_*/FACE_*/AI_* dưới đây — biến nào không set lấy mặc định theo
# AI_DEVICE (hoặc theo data/hw_profile.json nếu đã chạy scripts/bench_hw.py).
AI_DEVICE=auto
# Số luồng CPU cho torch (YOLO) và onnxruntime (InsightFace). Để trống thì CPU lấy
# tối đa 4 (một nửa số nhân vật lý), GPU lấy 2 — không giới hạn thì hai thư viện
# giành hết nhân của nhau.
AI_THREADS=
# auto: OpenVINO nếu thấy sẵn thư mục <model>_openvino_model/ cạnh .pt (CPU), còn
# không thì .pt. openvino: bắt buộc dùng OpenVINO, không có thư mục xuất thì báo lỗi
# rơi về .pt. Chỉ ảnh hưởng YOLO; không áp dụng khi AI_DEVICE=cuda.
AI_BACKEND=auto

# Model. Đổi FACE_MODEL thì phải đăng ký lại toàn bộ khuôn mặt.
YOLO_MODEL=yolo11s.pt
# Cỡ ảnh đưa vào YOLO. Để trống thì GPU=1280, CPU=960.
YOLO_IMGSZ=
FACE_MODEL=buffalo_l
FACE_SIM_THRESHOLD=0.36
# Để trống thì GPU=960, CPU=640.
FACE_DET_SIZE=
FACE_DET_THRESHOLD=0.30
# Số vùng quét lại khuôn mặt mỗi khung (người chưa định danh). Để trống thì GPU=4, CPU=1.
MAX_FACE_RESCANS=
# Số khung AI xử lý mỗi giây (ảnh hưởng cả track_buffer của ByteTrack, xem
# app/detector.py). Để trống thì GPU=10, CPU=4.
AI_FPS=

# Luồng xem trực tiếp (MJPEG — dự phòng cuối, dùng khi go2rtc tắt/không tới được)
STREAM_MAX_WIDTH=960
STREAM_JPEG_QUALITY=65
STREAM_OPEN_TIMEOUT=8
STREAM_RTSP_TRANSPORT=tcp
# Khung hình gửi ra trình xem mỗi giây — tách riêng khỏi AI_FPS vì xem trực tiếp
# cần mượt hơn tốc độ chạy AI. Mặc định 12 (xem app/hw.py).
STREAM_FPS=12

# go2rtc — relay RTSP -> WebRTC/MSE thẳng ra trình duyệt (xem app/go2rtc.py và
# service "go2rtc" trong docker-compose.yml). Tắt hẳn (quay về MJPEG) bằng:
#   GO2RTC_ENABLED=0
GO2RTC_ENABLED=1
# Cổng API nội bộ của go2rtc, horus-ai gọi qua đây (PUT /api/streams) và proxy
# lại cho trình duyệt dưới tiền tố /go2rtc/ — KHÔNG mở cổng này ra ngoài.
# Mặc định đúng khi chạy local (uv run python main.py) hoặc khi horus-ai CŨNG
# chạy network_mode: host như go2rtc. Nếu horus-ai chạy bridge (xem
# docker-compose.yml, ghi chú tại service "go2rtc"), đổi thành
# http://go2rtc:1984 và chuyển go2rtc sang cùng network/bridge với horus-ai.
GO2RTC_URL=http://127.0.0.1:1984
# Tuỳ chọn: STUN/TURN cho WebRTC, dạng JSON RTCIceServer[]. Qua tunnel
# Cloudflare thì WebRTC là UDP thẳng, không đi qua được nếu không có TURN —
# thiếu biến này thì trình duyệt tự rơi về MSE (vẫn qua tunnel HTTP/WS bình
# thường), không cần TURN. Ví dụ:
#   GO2RTC_ICE_SERVERS=[{"urls":["turn:turn.example.com:3478"],"username":"u","credential":"p"}]
GO2RTC_ICE_SERVERS=

# Cổng HTTP của horus-ai (compose chạy network_mode: host nên đổi ở đây)
HORUS_PORT=8199
